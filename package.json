{
  "name": "cortexlume",
  "version": "1.3.9",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @cortexlume/desktop start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:scripts && pnpm -r test && pnpm science:test",
    "version:metadata": "node scripts/generate-version-metadata.mjs",
    "version:check": "node scripts/assert-version-consistency.mjs",
    "release:metadata": "node scripts/generate-release-metadata.mjs",
    "release:verify": "node scripts/verify-release-metadata.mjs",
    "science:build": "node scripts/science.mjs build",
    "package:win": "pnpm science:build && pnpm --dir node_modules/electron-winstaller run install && set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& pnpm --filter @cortexlume/desktop make",
    "science:dev": "node scripts/science.mjs dev",
    "science:test": "node scripts/science.mjs test",
    "smoke:packaged:mcp": "node scripts/smoke_packaged_mcp.mjs",
    "smoke:packaged:mcp-screenshot": "node scripts/smoke_packaged_mcp_screenshot.mjs",
    "examples:build": "vite-node scripts/build-example-dataset.ts",
    "examples:verify": "vite-node scripts/build-example-dataset.ts --verify-only",
    "examples:package": "vite-node scripts/build-example-dataset.ts --package-only",
    "test:scripts": "node --test scripts/*.test.mjs",
    "package:linux": "node scripts/package-linux.mjs"
  }
}
